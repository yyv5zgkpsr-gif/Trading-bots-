# Copy this file to .env and fill in the values you want to override.

# Optional: enables LLM-backed narrative reasoning (news summaries, fundamental
# commentary, bull/bear debate theses). Without it, agents fall back to
# rule-based heuristics and the pipeline still runs end to end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Position sizing / risk controls ---
DEFAULT_ACCOUNT_EQUITY=10000
MAX_POSITION_PCT=0.05
DEFAULT_STOP_LOSS_PCT=0.05
DEFAULT_TAKE_PROFIT_PCT=0.10
MIN_CONVICTION=0.15

# --- Execution (Robinhood MCP) ---
# LIVE TRADING IS OFF BY DEFAULT. Both of the following must be set for the
# execution agent to place a real order; otherwise every order is a dry run
# that is logged but never sent anywhere. This repo bundles a Robinhood MCP
# server (robinhood_mcp/server.py) — point ROBINHOOD_MCP_COMMAND at it:
ENABLE_LIVE_TRADING=false
ROBINHOOD_MCP_COMMAND=python -m robinhood_mcp.server

# --- Robinhood MCP server settings (only read by robinhood_mcp/server.py) ---
# "paper" (default): a local simulated ledger, no brokerage account involved.
# "live": places REAL orders on a REAL Robinhood account via robin_stocks.
ROBINHOOD_MCP_MODE=paper
PAPER_STARTING_CASH=10000
# PAPER_STATE_PATH=./robinhood_mcp/paper_state.json

# Required only when ROBINHOOD_MCP_MODE=live:
# ROBINHOOD_USERNAME=
# ROBINHOOD_PASSWORD=
# ROBINHOOD_MFA_CODE=
