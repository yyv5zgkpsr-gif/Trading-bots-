# Copy this file to .env and fill in the values you want to override.

# Optional: enables LLM-backed narrative reasoning (news summaries, fundamental
# commentary, bull/bear debate theses). Without it, agents fall back to
# rule-based heuristics and the pipeline still runs end to end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Position sizing / risk controls ---
DEFAULT_ACCOUNT_EQUITY=10000
MAX_POSITION_PCT=0.05
DEFAULT_STOP_LOSS_PCT=0.05
DEFAULT_TAKE_PROFIT_PCT=0.10
MIN_CONVICTION=0.15

# --- Execution (Robinhood MCP) ---
# LIVE TRADING IS OFF BY DEFAULT. Both of the following must be set for the
# execution agent to place a real order; otherwise every order is a dry run
# that is logged but never sent anywhere. This repo bundles a Robinhood MCP
# server (robinhood_mcp/server.py) — point ROBINHOOD_MCP_COMMAND at it:
ENABLE_LIVE_TRADING=false
ROBINHOOD_MCP_COMMAND=python -m robinhood_mcp.server

# --- Robinhood MCP server settings (only read by robinhood_mcp/server.py) ---
# "paper" (default): a local simulated ledger, no brokerage account involved.
# "live": places REAL orders on a REAL Robinhood account via robin_stocks.
ROBINHOOD_MCP_MODE=paper
PAPER_STARTING_CASH=10000
# PAPER_STATE_PATH=./robinhood_mcp/paper_state.json

# Required only when ROBINHOOD_MCP_MODE=live:
# ROBINHOOD_USERNAME=
# ROBINHOOD_PASSWORD=
# ROBINHOOD_MFA_CODE=

# --- Exit monitor (robinhood_mcp/monitor.py; live mode only) ---
# RISK_LEDGER_PATH=./robinhood_mcp/risk_levels.json
MONITOR_POLL_SECONDS=30

# --- Dashboard (dashboard/app.py — mobile status/start/stop) ---
# Required: every /api/* route checks this as a bearer token; the app
# refuses to start without it. Generate one with e.g. `openssl rand -hex 32`.
# DASHBOARD_TOKEN=
# Optional: start the trading daemon / exit monitor the instant the
# dashboard process starts, instead of waiting for a tap from your phone.
AUTO_START_TRADING=false
AUTO_START_MONITOR=false
# DASHBOARD_SYMBOLS=BTC,ETH
DASHBOARD_INTERVAL_MINUTES=15

# --- ML-backed crypto signal (ml/, agents/ml_crypto_debate.py) ---
# Off by default: conviction comes from the rule-based technical score
# (agents/crypto_debate.py). Train a model first with `python -m ml.train
# <SYMBOL>` (needs requirements-ml.txt and real network access — see its
# docstring); it refuses to be used here unless its own held-out backtest
# judged it profitable (see ml/train.py's is_profitable).
USE_ML_SIGNAL=false
# ML_MODEL_DIR=./ml/models

# --- Crypto (crypto_main.py / robinhood_mcp crypto tools) ---
# Shares ENABLE_LIVE_TRADING / ROBINHOOD_MCP_COMMAND / ROBINHOOD_MCP_MODE /
# ROBINHOOD_USERNAME / ROBINHOOD_PASSWORD / ROBINHOOD_MFA_CODE above — crypto
# trades under the same Robinhood login as stocks, just a separate paper
# cash pool and separate live buying-power balance.
CRYPTO_DEFAULT_ACCOUNT_EQUITY=10000
CRYPTO_PAPER_STARTING_CASH=10000
# CRYPTO_PAPER_STATE_PATH=./robinhood_mcp/crypto_paper_state.json
# CRYPTO_MAX_POSITION_PCT / CRYPTO_STOP_LOSS_PCT / CRYPTO_TAKE_PROFIT_PCT
# each fall back to the stock MAX_POSITION_PCT / DEFAULT_STOP_LOSS_PCT /
# DEFAULT_TAKE_PROFIT_PCT above if unset.
MIN_CRYPTO_ORDER_USD=1.0
